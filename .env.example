# Attested RWA — environment. Copy the relevant blocks to packages/hardhat/.env and
# packages/nextjs/.env.local. Never commit real values. The app boots with no env at all
# (every route returns 200 with a configuration notice); env is only needed for on-chain actions.

# --- Operator (server-side native HAPI ops: token create, HCS, demo accounts) ---
# Testnet account from https://portal.hedera.com — ECDSA secp256k1 recommended (required for HIP-755).
OPERATOR_ID=0.0.xxxxxxx
OPERATOR_KEY=0x...                # ECDSA secp256k1 private key
OPERATOR_KEY_TYPE=ECDSA          # ECDSA (default) or ED25519

# --- Hardhat deploy (packages/hardhat/.env) ---
# The deployer key is managed by `yarn hardhat:account:*`; override the RPC only if needed.
# HEDERA_RPC_URL=https://testnet.hashio.io/api

# --- IPFS pinning (optional; without it the demo uses a labeled local CID store) ---
IPFS_PINNING_JWT=

# --- Frontend (packages/nextjs/.env.local) ---
# WalletConnect project id for wallet mode (optional in demo mode).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
