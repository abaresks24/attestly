# Testnet operator for the feasibility spikes. Copy to spikes/.env and fill in.
# Create a testnet account at https://portal.hedera.com and fund it from the faucet.
# ECDSA secp256k1 is required (S3/HIP-755 signs from an EVM wallet).
OPERATOR_ID=0.0.xxxxxxx
OPERATOR_KEY=0x...            # ECDSA secp256k1 private key
OPERATOR_KEY_TYPE=ECDSA      # ECDSA (default) or ED25519
